<?xml version='1.0' encoding='utf-8'?>
<MetaDataObject xmlns="http://v8.1c.ru/8.3/MDClasses" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:xr="http://v8.1c.ru/8.3/xcf/readable" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <AccountingRegister uuid="{uuid}">
    <Properties>
      <AuxiliaryListForm />
      <ChartOfAccounts>{ChartOfAccounts}</ChartOfAccounts>
      <Comment />
      <Correspondence>true</Correspondence>
      <DataLockControlMode>Managed</DataLockControlMode>
      <DefaultListForm />
      <Explanation />
      <ExtendedListPresentation />
      <FullTextSearch>DontUse</FullTextSearch>
      <IncludeHelpInContents>false</IncludeHelpInContents>
      <ListPresentation />
      <Name>{Name}</Name>
      <PeriodAdjustmentLength>3</PeriodAdjustmentLength>
      <Synonym>
        <v8:item>
          <v8:lang>ru</v8:lang>
          <v8:content>{Synonym_ru}</v8:content>
        </v8:item>
      </Synonym>
      <UseStandardCommands>true</UseStandardCommands>
    </Properties>
    <ChildObjects>
      <Dimension uuid="{uuidDim}">
        <Properties>
          <Name>Ключ</Name>
          <Synonym>
            <v8:item>
              <v8:lang>ru</v8:lang>
              <v8:content>Ключ</v8:content>
            </v8:item>
          </Synonym>
          <Comment />
          <Type>
            <v8:Type>xs:string</v8:Type>
            <v8:StringQualifiers>
              <v8:Length>150</v8:Length>
              <v8:AllowedLength>Variable</v8:AllowedLength>
            </v8:StringQualifiers>
          </Type>
          <PasswordMode>false</PasswordMode>
          <Format />
          <EditFormat />
          <ToolTip />
          <MarkNegatives>false</MarkNegatives>
          <Mask />
          <MultiLine>false</MultiLine>
          <ExtendedEdit>false</ExtendedEdit>
          <MinValue xsi:nil="true" />
          <MaxValue xsi:nil="true" />
          <FillChecking>DontCheck</FillChecking>
          <ChoiceFoldersAndItems>Items</ChoiceFoldersAndItems>
          <ChoiceParameterLinks />
          <ChoiceParameters />
          <QuickChoice>Auto</QuickChoice>
          <CreateOnInput>Auto</CreateOnInput>
          <ChoiceForm />
          <LinkByType />
          <ChoiceHistoryOnInput>Auto</ChoiceHistoryOnInput>
          <DenyIncompleteValues>false</DenyIncompleteValues>
          <Indexing>DontIndex</Indexing>
          <FullTextSearch>Use</FullTextSearch>
          <UseInTotals>true</UseInTotals>
          <Balance>false</Balance>
          <AccountingFlag />
          <ExtDimensionAccountingFlag />
        </Properties>
      </Dimension>
      <Resource uuid="{uuidResource}">
        <Properties>
          <Name>Сумма</Name>
          <Synonym>
            <v8:item>
              <v8:lang>ru</v8:lang>
              <v8:content>Сумма</v8:content>
            </v8:item>
          </Synonym>
          <Comment />
          <Type>
            <v8:Type>xs:decimal</v8:Type>
            <v8:NumberQualifiers>
              <v8:Digits>15</v8:Digits>
              <v8:FractionDigits>3</v8:FractionDigits>
              <v8:AllowedSign>Any</v8:AllowedSign>
            </v8:NumberQualifiers>
          </Type>
          <PasswordMode>false</PasswordMode>
          <Format />
          <EditFormat />
          <ToolTip />
          <MarkNegatives>false</MarkNegatives>
          <Mask />
          <MultiLine>false</MultiLine>
          <ExtendedEdit>false</ExtendedEdit>
          <MinValue xsi:nil="true" />
          <MaxValue xsi:nil="true" />
          <FillChecking>DontCheck</FillChecking>
          <ChoiceFoldersAndItems>Items</ChoiceFoldersAndItems>
          <ChoiceParameterLinks />
          <ChoiceParameters />
          <QuickChoice>Auto</QuickChoice>
          <CreateOnInput>Auto</CreateOnInput>
          <ChoiceForm />
          <LinkByType />
          <ChoiceHistoryOnInput>Auto</ChoiceHistoryOnInput>
          <FullTextSearch>Use</FullTextSearch>
          <Balance>false</Balance>
          <AccountingFlag />
          <ExtDimensionAccountingFlag />
        </Properties>
      </Resource>
    </ChildObjects>
  </AccountingRegister>
</MetaDataObject>
